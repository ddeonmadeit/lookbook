# Copy to .env (local) and/or set these in your host's environment variables.
# These come from your own Supabase project:
#   Supabase Dashboard -> Project Settings -> API
# Vite inlines them at BUILD time, so they must be set before/at build.

VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
